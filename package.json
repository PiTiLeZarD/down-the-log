{
    "name": "down-the-log",
    "version": "0.0.1",
    "main": "expo-router/entry",
    "homepage": "/down-the-log",
    "scripts": {
        "start": "expo start -c --port 19000",
        "start:all": "pnpm start",
        "start:android": "pnpm start --android",
        "start:ios": "pnpm start --ios",
        "start:web": "pnpm start --web",
        "start:tauri": "tauri dev",
        "build": "expo export --output-dir ./down-the-log",
        "build:all": "pnpm build -c",
        "build:android": "pnpm build -p android",
        "build:ios": "pnpm build -p ios",
        "build:web": "pnpm build -p web",
        "build:tauri": "tauri build",
        "eas:dev:ios": "eas build --profile ios-simulator --platform ios",
        "eas:dev:android": "eas build --profile android-simulator --platform android",
        "eas:dev:androidapk": "eas build --profile android-apk --platform android",
        "eas:run:ios": "eas build:run -p ios",
        "eas:start": "pnpm start --dev-client",
        "types": "tsc --noEmit",
        "clean": "rm -Rf down-the-log",
        "prepages": "pnpm clean && pnpm build:web",
        "pages": "gh-pages -t -b ghpages -d down-the-log",
        "refreshpota": "wget -O scripts/all_parks_ext.csv https://pota.app/all_parks_ext.csv && tsx scripts/pota.ts",
        "refreshsota": "wget -O scripts/summitslist.csv https://storage.sota.org.uk/summitslist.csv && tsx scripts/sota.ts",
        "refreshwwff": "wget -O scripts/wwff_directory.csv https://wwff.co/wwff-data/wwff_directory.csv && tsx scripts/wwff.ts",
        "potawwfflinks": "tsx scripts/linkpotawwff.ts ",
        "refreshdata": "pnpm refreshpota && pnpm refreshsota && pnpm refreshwwff && pnpm potawwfflinks"
    },
    "dependencies": {
        "@expo/html-elements": "57.0.0",
        "@expo/metro-runtime": "~57.0.5",
        "@expo/vector-icons": "^15.1.1",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-picker/picker": "2.11.4",
        "@react-native/normalize-colors": "^0.86.0",
        "@types/luxon": "^3.4.2",
        "axios": "^1.7.2",
        "expo": "^57.0.6",
        "expo-constants": "~57.0.5",
        "expo-dev-client": "~57.0.6",
        "expo-device": "~57.0.1",
        "expo-font": "~57.0.1",
        "expo-image": "~57.0.1",
        "expo-linking": "^57.0.3",
        "expo-location": "~57.0.4",
        "expo-router": "^57.0.6",
        "expo-splash-screen": "~57.0.4",
        "expo-status-bar": "^57.0.1",
        "gh-pages": "^6.1.1",
        "humanize-duration": "^3.32.1",
        "jssha": "^3.3.1",
        "luxon": "^3.4.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-dropzone": "^14.2.3",
        "react-hook-form": "^7.52.1",
        "react-native": "0.86.0",
        "react-native-big-list": "^1.6.1",
        "react-native-edge-to-edge": "^1.8.1",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-nitro-modules": "^0.36.1",
        "react-native-picker-select": "^9.0.1",
        "react-native-reanimated": "~4.5.0",
        "react-native-safe-area-context": "5.7.0",
        "react-native-screens": "4.25.2",
        "react-native-svg": "15.15.4",
        "react-native-svg-charts": "^5.4.0",
        "react-native-unistyles": "^3.3.0",
        "react-native-uuid": "^2.0.1",
        "react-native-web": "~0.21.2",
        "react-native-worklets": "0.10.0",
        "sweetalert2": "^11.12.1",
        "ts-node": "^10.9.2",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "^7.24.7",
        "@tauri-apps/cli": "^2.11.4",
        "@types/humanize-duration": "^3.27.4",
        "@types/react": "~19.2.17",
        "@types/react-native-svg-charts": "^5.0.16",
        "csv-parse": "^5.5.6",
        "fast-xml-parser": "^4.4.0",
        "fastest-levenshtein": "^1.0.16",
        "tsx": "^4.23.5",
        "typescript": "~6.0.3"
    },
    "private": true
}
