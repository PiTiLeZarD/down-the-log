{
    "name": "down-the-log",
    "version": "0.1.3",
    "main": "expo-router/entry",
    "homepage": "/down-the-log",
    "scripts": {
        "start": "expo start -c --port 19000",
        "start:all": "pnpm start",
        "start:android": "pnpm start --android",
        "start:ios": "pnpm start --ios",
        "start:web": "pnpm start --web",
        "start:tauri": "TAURI_BUILD=1 tauri dev",
        "build": "expo export --output-dir ./down-the-log",
        "build:all": "pnpm build -c && node scripts/pwa.mjs",
        "build:android": "pnpm build -p android",
        "build:ios": "pnpm build -p ios",
        "build:web": "pnpm build -p web && node scripts/pwa.mjs",
        "build:tauri": "TAURI_BUILD=1 tauri build",
        "eas:dev:ios": "eas build --profile ios-simulator --platform ios",
        "eas:dev:android": "eas build --profile android-simulator --platform android",
        "eas:dev:androidapk": "eas build --profile android-apk --platform android",
        "eas:run:ios": "eas build:run -p ios",
        "eas:start": "pnpm start --dev-client",
        "types": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "clean": "rm -Rf down-the-log",
        "prepages": "pnpm clean && pnpm build:web",
        "pages": "gh-pages -t -b ghpages -d down-the-log",
        "deploy:relay": "wrangler deploy --config scripts/wrangler.toml",
        "tag": "node scripts/tag.mjs",
        "refreshpota": "wget -O scripts/all_parks_ext.csv https://pota.app/all_parks_ext.csv && tsx scripts/pota.ts",
        "refreshsota": "wget -O scripts/summitslist.csv https://storage.sota.org.uk/summitslist.csv && tsx scripts/sota.ts",
        "refreshwwff": "wget -O scripts/wwff_directory.csv https://wwff.co/wwff-data/wwff_directory.csv && tsx scripts/wwff.ts",
        "refreshcty": "wget -O scripts/cty.dat https://www.country-files.com/bigcty/cty.dat && wget -O scripts/dxcclist.txt \"https://www.arrl.org/files/file/DXCC/2020%20Current_Deleted.txt\" && tsx scripts/cty.ts",
        "refreshstates": "wget -O scripts/ne_50m_admin_1_states_provinces.geojson https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_admin_1_states_provinces.geojson && tsx scripts/states.ts",
        "potawwfflinks": "tsx scripts/linkpotawwff.ts ",
        "refreshdata": "pnpm refreshpota && pnpm refreshsota && pnpm refreshwwff && pnpm refreshcty && pnpm potawwfflinks"
    },
    "dependencies": {
        "@expo/html-elements": "58.0.3",
        "@expo/metro-runtime": "~58.0.15",
        "@expo/vector-icons": "^15.1.1",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-picker/picker": "2.11.4",
        "@react-native/normalize-colors": "^0.88.0",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-notification": "^2.7.0",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "axios": "^1.20.0",
        "expo": "^58.0.17",
        "expo-asset": "~58.0.18",
        "expo-constants": "~58.0.13",
        "expo-dev-client": "~58.0.14",
        "expo-device": "~58.0.5",
        "expo-font": "~58.0.9",
        "expo-image": "~58.0.16",
        "expo-linking": "^58.0.14",
        "expo-location": "~58.0.18",
        "expo-notifications": "58.1.6",
        "expo-router": "^58.0.25",
        "expo-secure-store": "^58.0.2",
        "expo-splash-screen": "~58.0.11",
        "expo-sqlite": "~58.0.13",
        "expo-status-bar": "^58.0.4",
        "fast-xml-parser": "^5.11.2",
        "humanize-duration": "^3.35.0",
        "luxon": "^3.7.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-dropzone": "^20.1.4",
        "react-hook-form": "^7.90.0",
        "react-native": "0.88.0",
        "react-native-edge-to-edge": "^1.8.2",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-nitro-modules": "^0.37.1",
        "react-native-reanimated": "~4.7.1",
        "react-native-safe-area-context": "5.10.1",
        "react-native-screens": "4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-unistyles": "^3.6.0",
        "react-native-uuid": "^2.0.4",
        "react-native-web": "~0.21.4",
        "react-native-worklets": "0.13.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@tauri-apps/cli": "^2.12.4",
        "@types/humanize-duration": "^3.27.4",
        "@types/luxon": "^3.7.6",
        "@types/react": "~19.3.0",
        "csv-parse": "^7.0.3",
        "eslint": "^9.39.5",
        "eslint-config-expo": "^58.0.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fastest-levenshtein": "^1.0.16",
        "gh-pages": "^6.3.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.3"
    },
    "private": true
}
